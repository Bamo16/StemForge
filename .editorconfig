root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,axaml,xaml,csproj,slnx,json,md}]
indent_style = space
indent_size = 4

[*.cs]
# Braces are optional on a single-statement body, a multiline condition included. A loop whose
# body is itself an if, a loop or another control statement takes braces anyway; no option
# expresses that.
csharp_prefer_braces = false:silent
# Public members of a service stay instance members, so they can be injected.
dotnet_code_quality.CA1822.api_surface = private, internal
# FirstOrDefault() reads better than its indexed replacement, and LINQ already indexes a list.
dotnet_code_quality.CA1826.exclude_ordefault_methods = true
# An app's text is for its user, in their culture.
dotnet_diagnostic.CA1305.severity = none
# These protect other languages' callers of a library; an app has none.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1711.severity = none

[tests/**.cs]
# Inline arrays in test data are clearer than hoisting each into a static field.
dotnet_diagnostic.CA1861.severity = none
# Test names are sentences, so underscores are the style.
dotnet_diagnostic.CA1707.severity = none
# Caching a CompositeFormat for a test's one-off format string is noise.
dotnet_diagnostic.CA1863.severity = none
